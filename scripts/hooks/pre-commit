#!/bin/sh
# Fuel pre-commit gates.
#
# ⚠️ INSTALL THIS, or it does nothing:
#
#     sh scripts/install-hooks.sh
#
# ⚠️ NOT `git config core.hooksPath scripts/hooks`. That was this file's first
# instruction, it was FOLLOWED, and it silently disabled every hook in the
# repository for about a minute on 2026-08-26. `core.hooksPath` is one shared
# value but a RELATIVE path resolves per worktree, and exactly ONE of Fuel's 28
# worktrees contained this file -- the others are behind main. Git accepts a
# hooksPath pointing at nothing and runs NO hooks, with no error. See
# scripts/install-hooks.sh for the full account.
#
# This file is VERSION CONTROLLED; the hook git actually runs is not. That
# distinction is the whole reason this file exists. Fuel had a working
# pre-commit gate living only in `.git/hooks/pre-commit` — untracked, therefore
# absent from every fresh clone and invisible to code review. A gate nobody can
# see is a gate nobody can maintain, and one that silently does not exist in
# your checkout is worse than none, because its absence is indistinguishable
# from its success.
#
# Both gates below fire ONLY on the relevant STAGED files, so a lane is blocked
# by its own drift and never by someone else's.

# ---------------------------------------------------------------------------
# 0. UNRESOLVED CONFLICT MARKERS, on every staged text file.
# ---------------------------------------------------------------------------
# WHY THIS IS A HOOK-LEVEL CHECK AND NOT A PER-GATE ONE: every line-oriented
# checker in this repo is blind to conflict markers BY CONSTRUCTION.
#
#     scripts/check-gaps-table.py    keys on `^| ~*GAP-` and `^| ID`
#     method_rules_index_join.rs     keys on `^## ` and `method-rules.md#`
#     doc_declared_traits.rs         keys on rust fences
#
# A conflict marker begins with `<`, `=` or `>`, so NOT ONE of those patterns
# can match one. The checkers do not TOLERATE markers -- they cannot SEE them.
# Both sides of the conflict are then read as ordinary content, the totals go
# UP, and every gate reports clean on a file in the most broken state git can
# produce. Measured 2026-09-02: the gaps gate returned EXIT 0 on a conflicted
# `docs/gaps.md` three times in one rebase session.
#
# AND THERE IS NO OTHER LAYER. `git add`-ing a conflicted file marks it
# RESOLVED, so this hook runs against exactly that content -- the only thing
# between a botched resolution and `main` is a human noticing. The cost is not
# hypothetical: one conflict that night had a row differing on BOTH sides, and
# taking either side wholesale would have silently reverted another lane's
# landed work while leaving every row parsing and every gate green.
#
# THIS CANNOT JUDGE A RESOLUTION. It refuses to bless an UNRESOLVED one.
#
# SELF-REFERENCE: a naive version of this check flags its own source, because
# that source would contain the marker literals. The markers are therefore
# BUILT with printf rather than written, so the seven-character runs never
# appear in this file. Proven by staging this file and running the check.
#
# Scoped to STAGED files on purpose: an unstaged conflict elsewhere is not this
# commit's problem, and a hook that fails on someone else's mid-merge state is
# a hook people disable.
staged_any=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged_any" ]; then
    cm_lt=$(printf '<%.0s' 1 2 3 4 5 6 7)
    cm_eq=$(printf '=%.0s' 1 2 3 4 5 6 7)
    cm_gt=$(printf '>%.0s' 1 2 3 4 5 6 7)
    # -I skips binaries. The `=` arm is anchored to an EXACT seven-run so a
    # decorative rule of eight or more does not false-positive; the `<`/`>`
    # arms are not, because no real content starts that way.
    # ONE definition, used by the scan AND by the self-test below, so the
    # self-test exercises the same code rather than a copy of it.
    cm_scan() { grep -InE "^(${cm_lt}|${cm_gt})|^${cm_eq}\$" -- "$1" 2>/dev/null; }

    # RETAINED SELF-TEST, run on every commit -- not an authoring-time red.
    # This check will be green on virtually every commit forever, so without a
    # standing fixture it is indistinguishable from a check that does nothing.
    # The dirty fixture MUST flag and the clean one MUST NOT.
    cm_tmp=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}")
    printf 'a\n%s x\nb\n%s\nc\n%s y\n' "$cm_lt" "$cm_eq" "$cm_gt" > "$cm_tmp/dirty"
    printf 'a\nb < c\nd = e\nf > g\n' > "$cm_tmp/clean"
    if [ "$(cm_scan "$cm_tmp/dirty" | wc -l)" -ne 3 ]; then
        echo "pre-commit: conflict-marker detector FAILED its own fixture" >&2
        echo "  (the sabotaged fixture was not flagged -- the check is inert)" >&2
        rm -rf "$cm_tmp"
        exit 1
    fi
    if [ -n "$(cm_scan "$cm_tmp/clean")" ]; then
        echo "pre-commit: conflict-marker detector flagged a CLEAN fixture" >&2
        rm -rf "$cm_tmp"
        exit 1
    fi
    rm -rf "$cm_tmp"

    conflicts=$(
        echo "$staged_any" | while IFS= read -r cf; do
            [ -f "$cf" ] || continue
            cm_scan "$cf" | sed "s#^#${cf}:#"
        done
    )
    if [ -n "$conflicts" ]; then
        echo ""
        echo "pre-commit: UNRESOLVED CONFLICT MARKERS in staged files:"
        echo "$conflicts" | sed 's/^/    /'
        echo ""
        echo "  Every line-oriented gate in this repo is structurally blind to"
        echo "  these and reports CLEAN on a conflicted file, and \`git add\` has"
        echo "  already marked the file resolved. Resolve by READING BOTH SIDES:"
        echo "  taking one wholesale can silently revert another lane's work."
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# 1. Table integrity for docs/gaps.md
# ---------------------------------------------------------------------------
# Run as a hook because the COORDINATOR kept bypassing it by hand. Four times in
# one session the gate was correct and was defeated by HOW git was invoked: once
# by `echo`ing its exit code inside an && chain, once by piping it through
# `tail` (losing the violating line), and twice by re-running a failed
# `git commit` on its own after a staging error -- dropping the gate from the
# chain while working around something unrelated.
#
# Every one of those pushed a corrupted row to main. The gate never failed; the
# invocation did. A hook takes the invocation out of the loop.
if git diff --cached --name-only | grep -q '^docs/gaps\.md$'; then
    python scripts/check-gaps-table.py || {
        echo ""
        echo "pre-commit: docs/gaps.md table integrity FAILED (see above)."
        echo "  A row is one line; escape every literal '|' inside a code span as \|."
        exit 1
    }
fi

# ---------------------------------------------------------------------------
# 2. Formatting, on staged .rs files only
# ---------------------------------------------------------------------------
# WHY THIS EXISTS: `cargo fmt --all` has now been landed TWICE in seven days.
# a63d8f55 (2026-08-19, 647 files) is titled "closes the Rustfmt gate"; 212
# commits later the tree had re-accumulated 158 hunks across 72 files, about
# 0.75 hunks per commit, and b25164e6 had to close it again.
#
# The Rustfmt CI job was not broken -- it went green on 2026-08-20 and red again
# as drift accumulated. Its signal was destroyed by AGGREGATION: the run badge
# stayed red for a permanently-failing Clippy sibling, and nobody reads a red
# badge to ask which job flipped. One always-red job makes every other job in
# that run unreadable.
#
# So the drift was never anyone's fault and never anyone's signal. This catches
# it at the commit, where the person who caused it is standing.
staged_rs=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$')
if [ -n "$staged_rs" ]; then
    # A missing rustfmt must FAIL, not skip. A gate that passes silently when
    # its tool is absent is the "absence indistinguishable from success" trap,
    # and rust-toolchain.toml pins rustfmt as a component precisely so this
    # cannot legitimately happen.
    if ! command -v rustfmt >/dev/null 2>&1; then
        echo ""
        echo "pre-commit: rustfmt NOT FOUND, so the formatting gate cannot run."
        echo "  This is a hard failure, not a skip -- a gate that passes when its"
        echo "  tool is missing reports success it did not verify."
        echo "  rust-toolchain.toml pins rustfmt as a component; try \`rustup component add rustfmt\`."
        exit 1
    fi

    # NOTE: rustfmt reads the WORKING TREE, not the staged blob. For a partially
    # staged file the two differ, and this checks the file on disk. Accepted:
    # the failure direction is a false RED on unstaged edits, which is loud and
    # obvious, never a false green.
    #
    # Checked one file at a time and reported by the path GIT gave us, rather
    # than by parsing rustfmt's output. The first version of this gate parsed
    # `Diff in <path>` and printed `\\?\C:\Projects\...` -- a Windows extended
    # path -- because rustfmt emits `Diff in <path>:<line>:` here and not the
    # `at line N` form the parse assumed. The verdict was right and the message
    # was unusable; not parsing at all removes the failure mode instead of
    # patching it.
    # ⚠️ THE EDITION MUST BE RESOLVED PER FILE, NOT HARDCODED. The first version
    # of this gate ran `rustfmt --edition 2024` on everything. Two crates declare
    # their own edition -- `fuel-onnx` and `fuel-metal-kernels` are edition 2021 --
    # so their files were checked against a style edition they are not written in.
    #
    # That is worse than a false positive: it is UNSATISFIABLE BY ITS OWN ADVICE.
    # The hook says "run cargo fmt", cargo fmt formats to the crate's real edition
    # 2021, and the hook rejects the result again. A gate that cannot be satisfied
    # by following its own instructions teaches people to `--no-verify`, and the
    # bypass habit is a worse outcome than the drift this gate exists to prevent.
    # It also names files the committer never touched, which reads as the gate
    # being broken rather than the code being wrong -- and it was.
    #
    # `cargo fmt` was right and this gate was wrong: `cargo fmt -p fuel-onnx
    # --check` exits 0 on the same file this gate rejected. cargo passes each
    # crate its real edition; a bare `rustfmt` does not.
    unformatted=""
    for f in $staged_rs; do
        # Walk up to the owning crate's Cargo.toml.
        crate_dir=$(dirname "$f")
        while [ "$crate_dir" != "." ] && [ "$crate_dir" != "/" ] && [ ! -f "$crate_dir/Cargo.toml" ]; do
            crate_dir=$(dirname "$crate_dir")
        done
        # Match ONLY an explicit `edition = "NNNN"`. The 34 crates that write
        # `edition.workspace = true` must fall through to the default: a looser
        # pattern returns that whole line unmatched rather than empty, so an
        # is-it-empty check never fires and the edition becomes garbage.
        ed=""
        if [ -f "$crate_dir/Cargo.toml" ]; then
            ed=$(grep -m1 -E '^edition[[:space:]]*=[[:space:]]*"[0-9]+"' "$crate_dir/Cargo.toml" 2>/dev/null \
                 | sed -E 's/.*"([0-9]+)".*/\1/')
        fi
        [ -z "$ed" ] && ed=2024   # workspace default
        rustfmt --edition "$ed" --check "$f" >/dev/null 2>&1 || unformatted="$unformatted
$f"
    done
    unformatted=$(echo "$unformatted" | sed '/^$/d')
    if [ -n "$unformatted" ]; then
        echo ""
        echo "pre-commit: staged Rust files are NOT rustfmt-clean:"
        echo "$unformatted" | sed 's/^/    /'
        echo ""
        echo "  Fix:  cargo fmt        (then re-stage)"
        echo ""
        echo "  This gate exists because \`cargo fmt --all\` was landed twice in one"
        echo "  week. Drift is cheap to prevent here and costs a 72-file landing"
        echo "  against ~27 live worktrees to clean up later."
        exit 1
    fi
fi
